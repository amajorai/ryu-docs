{
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fumadocs/api-docs": "0.0.4",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@ryu/assistant-widget": "workspace:*",
    "@ryu/auth": "workspace:*",
    "@ryu/blocks": "workspace:*",
    "@ryu/browser-local-ai": "workspace:*",
    "@ryu/portable-packages": "workspace:*",
    "@ryu/ui": "workspace:*",
    "@scalar/api-client-react": "2.0.22",
    "cn": "^0.2.4",
    "fumadocs-core": "16.12.0",
    "fumadocs-mdx": "14.2.9",
    "fumadocs-openapi": "11.0.6",
    "fumadocs-ui": "16.12.0",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.1",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "name": "fumadocs",
  "private": true,
  "scripts": {
    "build": "bun run generate:ui && bun run generate:docs && next build --turbopack",
    "generate:docs": "bun ./scripts/generate-docs.ts",
    "check:docs": "bun ./scripts/generate-docs.ts --check",
    "generate:catalog": "bun ./scripts/generate-catalog.ts",
    "generate:catalog:check": "bun ./scripts/generate-catalog.ts --check",
    "check:catalog": "bun ./scripts/generate-catalog.ts --check",
    "generate:ui": "bun ./scripts/generate-ui-docs.ts",
    "generate:figures": "node ./scripts/generate-figures.mjs",
    "check:figures": "node ./scripts/generate-figures.mjs --check",
    "dev": "next dev --webpack --port=4000",
    "start": "next start",
    "test": "bun test src scripts/generate-catalog.test.ts scripts/generate-ui-docs.test.ts && bun test e2e/docs-framework-provider.interaction.test.tsx",
    "test:e2e:coverage": "playwright test --config e2e/coverage-pages.playwright.config.ts",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint:links": "fumadocs-mdx && bun ./scripts/lint-links.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "clean": "node ../../scripts/clean-paths.mjs paths .next out build .source"
  },
  "version": "0.0.0"
}
